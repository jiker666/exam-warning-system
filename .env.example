# ===== 数据库（MySQL）=====
# 首次使用请先执行: mysql -u root < scripts/init_mysql.sql （或手动创建库）
DATABASE_URL=mysql+pymysql://root@localhost:3306/exam_warning?charset=utf8mb4
# 本地没有 MySQL 时可临时退回 SQLite：
# DATABASE_URL=sqlite:///backend/app.db

# ===== JWT =====
JWT_SECRET_KEY=please-change-me-to-a-random-string
JWT_EXPIRE_HOURS=24

# ===== AssemblyAI =====
# 在 https://www.assemblyai.com/ 获取 API Key。
# 留空时系统自动进入 Demo Mock 模式，分析结果会明确标记 "Mock Result"，
# 不会伪装成真实 AssemblyAI 返回。
ASSEMBLYAI_API_KEY=
# 转录语言（本项目异常关键词为中文，默认 zh）
TRANSCRIPT_LANGUAGE_CODE=zh

# ===== Demo 模式 =====
# true: 即使配置了 API Key 也强制使用预置模拟转录（现场演示兜底开关）
DEMO_MODE=false

# ===== Flask =====
FLASK_PORT=5001
FLASK_DEBUG=false
